{
  "name": "tradecat-idr",
  "version": "0.4.0",
  "private": true,
  "description": "ScriptCat userscripts: IDR orderbook conversion + deposit/withdraw status for gate.com and mexc.fm",
  "author": "sulthonuladib",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "watch": "bun run build.ts --watch",
    "bump": "bun run scripts/bump.ts",
    "test": "bun test && bun run test:dom",
    "test:dom": "bun run test/dom.test.mjs",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "check:watch": "tsc -p tsconfig.json --watch",
    "live": "bun run scripts/live-check.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
